{
  "name": "reline-web",
  "version": "0.0.0",
  "private": true,
  "description": "Editor for Reline image-processing pipelines",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest",
    "lint": "oxlint --type-aware --type-check",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "plugin:build": "vite build --config examples/sequence/vite.config.ts && node scripts/build-catalog.mjs",
    "plugin:catalog": "node scripts/build-catalog.mjs",
    "plugin:bundle": "node scripts/bundle-plugins.mjs",
    "plugin:pin": "node scripts/pin-plugin.mjs writer-suffix",
    "sdk:exports": "node --conditions=browser scripts/gen-host-exports.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@rebase-ui/reze": "0.1.2",
    "marked": "^18.0.12",
    "notepack.io": "^3.0.1",
    "reze-js": "0.1.0",
    "sugar-high": "^2.4.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@rezejs/testing-library": "0.1.0",
    "@rezejs/vite-plugin": "0.1.0",
    "@types/node": "^26.5.0",
    "jsdom": "^25.0.1",
    "oxfmt": "^0.67.0",
    "oxlint": "~1.79.0",
    "oxlint-tsgolint": "^7",
    "sass": "^1.104.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4"
}
